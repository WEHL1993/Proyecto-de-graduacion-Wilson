# Copiar a .env (`make env`) y ajustar. .env está excluido de git.

# --- PostgreSQL ---
POSTGRES_USER=ds_user
POSTGRES_PASSWORD=ds_password
POSTGRES_DB=ds_predictive
# Host/puerto vistos desde la máquina local (dentro de Docker el backend usa postgres:5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Opcional: URL completa; si se define, tiene prioridad sobre las variables anteriores.
# DATABASE_URL=postgresql+psycopg2://ds_user:ds_password@localhost:5432/ds_predictive

# --- Seguridad ---
JWT_SECRET_KEY=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=60

# --- CORS --- (lista separada por comas; frontend en fase posterior)
CORS_ORIGINS=http://localhost:5173

# --- App ---
ENVIRONMENT=local
